# Google Search API Configuration
# Để sử dụng tính năng tìm kiếm Google, cần cấu hình các biến sau:

# Đường dẫn đến file service account JSON của Google Cloud
# Bạn có thể tạo service account tại: https://console.cloud.google.com/
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/your/service-account.json

# Custom Search Engine ID 
# Tạo CSE tại: https://programmablesearchengine.google.com/
GOOGLE_CSE_ID=abcd1234efgh5678ijkl9012mnop3456qrst7890uvwx

# Ví dụ thay đổi cho môi trường của bạn:
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/your/service-account.json
# GOOGLE_CSE_ID=your_cse_id_here
